        minRadius: 100,       // px, chỉ tác dụng khi chuột gần đầu rắn hơn giá trị này
        activationKey: 'Control',

        debug: false          // log nhịp mỗi giây ra Console (F12)
    };
    window.__lbsCFG = CONFIG;  // chỉnh nhanh trong Console nếu cần
    // ==================================================

    const TWO_PI = Math.PI * 2;
    const log = (...a) => CONFIG.debug && console.log('[LBS]', ...a);

    let shaking = false;      // Ctrl đang giữ
    let rafId = 0;            // 0 = không có loop (đảm bảo chỉ 1 loop)
    let hasPos = false;
    let realX = 0, realY = 0; // vị trí chuột thật = hướng chính
    let emitted = false;      // đã gửi event giả (cần trả vị trí thật khi dừng)
    let lastT = 0;
    let phase = 0;
    let sign = 1, holdCount = 0;
    let lastEmitX = 0, lastEmitY = 0;
    let canvas = null;
    let dbgStart = 0, dbgTicks = 0, dbgMaxDt = 0, dbgSumDt = 0;

    // ---------- DOM (event chuột giả) ----------
    function getTarget() {
        if (!canvas || !canvas.isConnected) {
            canvas = document.getElementById('canvas');   // canvas game (canvas2 là overlay)
            if (!canvas) {
                let best = null, bestArea = 0;
                const list = document.getElementsByTagName('canvas');
                for (let i = 0; i < list.length; i++) {
                    if (list[i].id === 'canvas2') continue;
                    const r = list[i].getBoundingClientRect();
                    const a = r.width * r.height;
                    if (a > bestArea) { bestArea = a; best = list[i]; }
                }
                canvas = best;
            }
            log('canvas target:', canvas);
        }
        return canvas || document.documentElement;
    }

    function getCenter(target) {
        if (target === document.documentElement) {
            return { x: innerWidth / 2, y: innerHeight / 2 };
        }
        const r = target.getBoundingClientRect();
        return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    }

    // Event giả có isTrusted = false nên handler của ta không chặn lại chính nó
    function emit(x, y) {
        const target = getTarget();
        const init = {
            bubbles: true, cancelable: true, composed: true, view: window,
            clientX: x, clientY: y, screenX: x, screenY: y,
            movementX: x - lastEmitX, movementY: y - lastEmitY,
            ctrlKey: false, buttons: 0
        };
        lastEmitX = x; lastEmitY = y;
        emitted = true;
        try {
            if (typeof PointerEvent === 'function') {
                target.dispatchEvent(new PointerEvent('pointermove', Object.assign(
                    { pointerId: 1, pointerType: 'mouse', isPrimary: true }, init)));
            }
            target.dispatchEvent(new MouseEvent('mousemove', init));
        } catch (err) {
            log('emit error', err);
        }
    }

    function nextOffset(dt) {
        if (CONFIG.waveform === 'hold') {
            const s = sign;
            if (++holdCount >= Math.max(1, CONFIG.holdFrames | 0)) {
                holdCount = 0;
                sign = -sign;
            }
            return s;
        }
        phase = (phase + dt * CONFIG.frequency) % 1;
        return CONFIG.waveform === 'square'
            ? (phase < 0.5 ? 1 : -1)
            : Math.sin(TWO_PI * phase);
    }

    // ---------- Shake loop (duy nhất 1 RAF loop) ----------
    function tick(t) {
        if (!shaking) return;

        const rawDt = t - lastT;
        const dt = Math.min(rawDt / 1000, 0.05);
        lastT = t;

        if (CONFIG.debug) {
            dbgTicks++; dbgSumDt += rawDt;
            if (rawDt > dbgMaxDt) dbgMaxDt = rawDt;
            if (t - dbgStart >= 1000) {
                log('frames/s:', dbgTicks,
                    'avg dt(ms):', (dbgSumDt / dbgTicks).toFixed(2),
                    'max dt(ms):', dbgMaxDt.toFixed(1));
                dbgStart = t; dbgTicks = 0; dbgSumDt = 0; dbgMaxDt = 0;
            }
        }

        if (!hasPos) return;

        const c = getCenter(getTarget());
        const angle = nextOffset(dt) * CONFIG.amplitude;
        let dx = realX - c.x, dy = realY - c.y;
        let r = Math.hypot(dx, dy);
        if (r < 1) { dx = 1; dy = 0; r = 1; }
        if (r < CONFIG.minRadius) {
            const k = CONFIG.minRadius / r;
            dx *= k; dy *= k;
        }
        const cos = Math.cos(angle), sin = Math.sin(angle);
        emit(c.x + dx * cos - dy * sin, c.y + dx * sin + dy * cos);
    }

    function rafLoop(t) {
        rafId = requestAnimationFrame(rafLoop);
        tick(t);
    }

    function startShake() {
        if (!CONFIG.shakeEnabled || shaking) return;
        shaking = true;
        phase = 0; sign = 1; holdCount = 0;
        lastT = performance.now();
        dbgStart = lastT; dbgTicks = 0; dbgSumDt = 0; dbgMaxDt = 0;
        if (!rafId) rafId = requestAnimationFrame(rafLoop);
        log('shake ON');
    }

    function stopShake() {
        if (!shaking && !rafId) return;
        shaking = false;
        if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
        if (hasPos && emitted) { emit(realX, realY); emitted = false; } // trả điều khiển thật ngay
        log('shake OFF');
    }

    // ---------- Input handlers ----------
    function onMove(e) {
        if (!e.isTrusted) return;
        realX = e.clientX; realY = e.clientY;
        hasPos = true;

        if (shaking) {
            if (!e.ctrlKey) { stopShake(); return; } // fail-safe nếu lỡ mất keyup Ctrl
            e.stopImmediatePropagation();
        }
    }

    function onKeyDown(e) {
        if (e.key === CONFIG.activationKey && !e.repeat) startShake();
    }

    function onKeyUp(e) {
        if (e.key === CONFIG.activationKey) stopShake();
    }

    const cap = { capture: true, passive: true };
    window.addEventListener('pointermove', onMove, cap);
    window.addEventListener('mousemove', onMove, cap);
    window.addEventListener('keydown', onKeyDown, cap);
    window.addEventListener('keyup', onKeyUp, cap);
    window.addEventListener('blur', stopShake);
    window.addEventListener('pagehide', stopShake);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stopShake(); });
    document.addEventListener('contextmenu', stopShake, true);
})();
