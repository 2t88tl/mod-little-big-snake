function lbsMakeDraggable(frame, handle) {
    if (!frame || !handle || handle.__lbsDrag) return
    handle.__lbsDrag = true
    let dragging = false, sx = 0, sy = 0, ox = 0, oy = 0
    handle.style.cursor = 'move'
    handle.style.userSelect = 'none'
    handle.style.touchAction = 'none'
    handle.addEventListener('pointerdown', e => {
        if (e.button !== 0) return
        const r = frame.getBoundingClientRect()
        ox = r.left; oy = r.top
        sx = e.screenX; sy = e.screenY
        dragging = true
        frame.style.right = 'auto'
        frame.style.left = ox + 'px'
        frame.style.top = oy + 'px'
        try { handle.setPointerCapture(e.pointerId) } catch (_) {}
        e.preventDefault()
    })
    handle.addEventListener('pointermove', e => {
        if (!dragging) return
        const w = frame.offsetWidth
        let x = ox + (e.screenX - sx)
        let y = oy + (e.screenY - sy)
        x = Math.min(Math.max(0, x), Math.max(0, window.innerWidth - w))
        y = Math.min(Math.max(0, y), Math.max(0, window.innerHeight - 40))
        frame.style.left = x + 'px'
        frame.style.top = y + 'px'
        window.__lbsGuiPos = { left: x, top: y }
    })
    const end = e => {
        dragging = false
        try { handle.releasePointerCapture(e.pointerId) } catch (_) {}
    }
    handle.addEventListener('pointerup', end)
    handle.addEventListener('pointercancel', end)
}
