// Tìm pattern trong HEAP (sử dụng kmpMatching đã có)
function findPatternInHeap(pattern, start = 0) {
    try {
        const heap = UnityBridge && UnityBridge.unityInstance && UnityBridge.unityInstance.Module.HEAPU8;
        if (!heap) return -1;
        const sub = heap.subarray(start);
        const matches = kmpMatching(sub, pattern);
        if (matches && matches.length) return matches[0] + start;
    } catch (e) {
        console.warn('findPatternInHeap error', e);
    }
    return -1;
}
const ZOOM_PATTERN = [163,2,0,0,143,194,245,59];
function ensureIndex() {
    try {
        if (window.index && Number.isInteger(window.index) && window.index > 0) {
            const buf = UnityBridge.unityInstance.Module.HEAP8.buffer;
            if (window.index + 4 <= buf.byteLength) return true;
        }
    } catch (e) {
        // continue to search
    }
    let found = findPatternInHeap(ZOOM_PATTERN, 63000000);
    if (found > -1) {
        window.index = found;
        console.info('ensureIndex: found at', found);
        return true;
    }
    // fallback: search whole heap (slower)
    found = findPatternInHeap(ZOOM_PATTERN, 0);
    if (found > -1) {
        window.index = found;
        console.info('ensureIndex: found fallback at', found);
        return true;
    }
    console.warn('ensureIndex: pattern not found');
    return false;
}
const updateScale = (value) => {
    try {
        if (!UnityBridge || !UnityBridge.unityInstance || !UnityBridge.unityInstance.Module) {
            console.warn('updateScale: UnityBridge not ready');
            return;
        }
        ensureIndex();
        const buffer = UnityBridge.unityInstance.Module.HEAP8.buffer;
        const dv = new DataView(buffer);
        if (!window.index || window.index + 4 > buffer.byteLength) {
            console.warn('updateScale: invalid index or out of range', window.index, buffer.byteLength);
            return;
        }
        dv.setInt32(window.index, value, true);
    } catch (e) {
        console.error('updateScale error:', e);
        window.index = 0; // reset so next attempt will search again
    }
}
